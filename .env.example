DATABASE_URL=sqlite:///./socialintel.db
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-immediately
CORS_ORIGINS=http://localhost:8000
MAX_CRAWL_BYTES=2000000

# Telegram: only use an account/session you control and data it is authorized to access.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# WhatsApp Cloud API webhook verification/signature.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Meta Graph API.
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
